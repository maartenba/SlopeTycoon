{
  "name": "slope-tycoon",
  "version": "0.2.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maartenba/SlopeTycoon.git"
  },
  "homepage": "https://slopetycoon.com/",
  "bugs": {
    "url": "https://github.com/maartenba/SlopeTycoon/issues"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "vite-node scripts/whats-new.ts",
    "whats-new": "vite-node scripts/whats-new.ts",
    "prebuild": "vite-node scripts/gen-icons.ts --if-missing && vite-node scripts/whats-new.ts",
    "build": "tsc --noEmit && vite build",
    "gen:icons": "vite-node scripts/gen-icons.ts",
    "verify:pwa": "vite-node scripts/verify-pwa.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src tests sw vite-plugins scripts --ext .ts",
    "typecheck": "tsc --noEmit",
    "test:balance": "BALANCE=1 vitest run tests/game/balance.test.ts",
    "analysis:ski": "SKI_ANALYSIS=1 vitest run --config vitest.analysis.config.ts tests/analysis/ski.analysis.ts",
    "analysis:timeflow": "TIMEFLOW_ANALYSIS=1 vitest run --config vitest.analysis.config.ts tests/analysis/timeflow.analysis.ts",
    "analysis:timeflow:report": "vite-node scripts/analysis/timeflowReport.ts",
    "analysis:hiking": "vitest run --config vitest.analysis.config.ts tests/analysis/hiking.analysis.ts",
    "analysis:hiking:all": "sh scripts/analysis/hiking-all.sh",
    "analysis:hunger": "HUNGER_ANALYSIS=1 vitest run --config vitest.analysis.config.ts tests/analysis/hunger.analysis.ts",
    "analysis:hiking:report": "vite-node scripts/analysis/hikingReport.ts",
    "test:perf": "PERF=1 vitest run --config vitest.perf.config.ts",
    "test:all": "npm test && npm run test:perf",
    "boot:shots": "vite-node scripts/boot-shots.ts",
    "shot": "vite-node scripts/shot.ts",
    "flicker": "vite-node scripts/flicker-test.ts",
    "audio:render": "vite-node scripts/audio-render.ts",
    "audio:crosscheck": "vite-node scripts/audio-crosscheck.ts",
    "flicker:building": "vite-node scripts/flicker-building.ts",
    "shot:suite": "vite-node scripts/shot-suite.ts",
    "perf:ground": "vite-node scripts/perf-ground.ts",
    "recap:shot": "vite-node scripts/recap-shot.ts",
    "ui:suite": "vite-node scripts/ui-suite.ts",
    "ui2:suite": "vite-node scripts/ui2-suite.ts",
    "size": "vite-node scripts/report-size.ts",
    "postbuild:pages": "vite-node scripts/post-build.ts",
    "build:pages": "npm run typecheck && npm run lint && npm test && npm run build && npm run postbuild:pages && npm run verify:pwa && npm run verify:pwa -- --base /slopetycoon/ && npm run size && npm run build:site && npm run site:check && npm run verify:site",
    "deploy:check": "vite-node scripts/deploy-check.ts",
    "preview:pages": "vite-node scripts/serve-subpath.ts",
    "deploy:gh-pages": "vite-node scripts/deploy-gh-pages.ts",
    "release": "vite-node scripts/release.ts",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run build && npm run verify:pwa && npm run size",
    "demo:shots": "vite-node scripts/demo-shots.ts",
    "town:shots": "vite-node scripts/town-shots.ts",
    "town:sheet": "vite-node scripts/town-sheet.ts",
    "analysis:towns": "vite-node scripts/analysis/townSeedScan.ts",
    "site:shots": "vite-node scripts/site/shots.ts",
    "site:build": "vite-node scripts/site/run-build.ts",
    "build:site": "vite-node scripts/gen-icons.ts --if-missing && vite-node scripts/whats-new.ts && tsc --noEmit && vite build --outDir dist-site/play --emptyOutDir && vite-node scripts/site/run-build.ts",
    "site:check": "vite-node scripts/site/check.ts",
    "site:dev": "vite-node scripts/site/dev.ts",
    "docs:player": "npm run site:build && npm run site:check",
    "verify:site": "vite-node scripts/site/verify-site.ts",
    "site:og": "vite-node scripts/site/og.ts",
    "site:preview-shots": "vite-node scripts/site/preview-shots.ts",
    "docs:img": "vite-node scripts/docs-img-optimize.ts",
    "licenses": "vite-node scripts/licenses.ts",
    "touch:e2e": "vite-node scripts/touch-e2e.ts",
    "offline:splash": "vite-node scripts/offline-splash.ts",
    "play:sanity": "vite-node scripts/play-sanity.ts",
    "phase6:sanity": "vite-node scripts/phase6-sanity.ts",
    "analytics:e2e": "vite-node scripts/analytics-e2e.ts",
    "summer:sanity": "vite-node scripts/summer-sanity.ts",
    "winter:tours": "vite-node scripts/winter-tours-sanity.ts",
    "winter:sanity": "vite-node scripts/winter-sanity.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "marked": "^18.1.1",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "yaml": "^2.8.1"
  }
}
